{
  "name": "telao",
  "productName": "Telão",
  "version": "1.2.0",
  "description": "Telão para Windows: tela, voz e chat com os amigos",
  "main": "main.js",
  "author": "Telão",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.12"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.20"
  },
  "build": {
    "appId": "app.telao.desktop",
    "productName": "Telão",
    "artifactName": "Telao-Setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "picker.html",
      "picker-preload.js",
      "tray.png",
      "app-config.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telão",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "brabont1-pixel",
        "repo": "telao",
        "releaseType": "release"
      }
    ]
  },
  "repository": "https://github.com/brabont1-pixel/telao"
}